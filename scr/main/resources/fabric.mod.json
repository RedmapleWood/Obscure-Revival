          "redmaple.obscurerevival.ObscureRevival"
		],
		"client": [
			"redmaple.obscurerevival.ObscureRevivalClient"
		]
	},
	"mixins": [
		"obscurerevival.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
